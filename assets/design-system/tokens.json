{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Drive Venture Design System Foundation",
  "version": "1.0.0",
  "backlog": "BKLG-0161",
  "authorities": {
    "palette": "Central Configuration / WebsitePalette — canonical 2026-09-08",
    "visualStyle": "DV-STYLE-PIXEL-16BIT",
    "experienceArchitecture": ["DD-WEB-005", "ADR-040"]
  },
  "primitives": {
    "color": {
      "asphalt": "#111820",
      "nightRoad": "#17324D",
      "driveVentureYellow": "#F4B820",
      "warmWhite": "#F7F3E8",
      "silver": "#AEB8C2",
      "highwayGreen": "#2F7D4A",
      "panelCharcoal": "#202B35",
      "trueBlack": "#080B0E"
    },
    "fontFamily": {
      "display": "Orbitron, \"Arial Narrow\", sans-serif",
      "body": "Inter, Aptos, \"Segoe UI\", system-ui, sans-serif"
    },
    "fontWeight": {
      "regular": 400,
      "semibold": 600,
      "bold": 700,
      "heavy": 800
    },
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem"
    },
    "radius": {
      "none": "0",
      "small": "0.25rem",
      "medium": "0.5rem",
      "round": "999px"
    },
    "borderWidth": {
      "hairline": "1px",
      "control": "2px",
      "pixel": "4px"
    },
    "shadow": {
      "pixelSmall": "0.2rem 0.2rem 0 #080B0E",
      "pixelMedium": "0.4rem 0.4rem 0 #080B0E",
      "pixelLarge": "0.65rem 0.65rem 0 #080B0E"
    },
    "motion": {
      "instant": "0ms",
      "fast": "150ms",
      "standard": "200ms"
    },
    "layout": {
      "contentMax": "76rem",
      "touchTargetMin": "44px",
      "compactBreakpoint": "760px"
    }
  },
  "semantic": {
    "color": {
      "background.canvas": "{primitives.color.asphalt}",
      "background.atmospheric": "{primitives.color.nightRoad}",
      "surface.default": "{primitives.color.panelCharcoal}",
      "text.primary": "{primitives.color.warmWhite}",
      "text.secondary": "{primitives.color.silver}",
      "accent.primary": "{primitives.color.driveVentureYellow}",
      "status.success": "{primitives.color.highwayGreen}",
      "border.strong": "{primitives.color.trueBlack}"
    },
    "typography": {
      "display.family": "{primitives.fontFamily.display}",
      "body.family": "{primitives.fontFamily.body}",
      "label.weight": "{primitives.fontWeight.heavy}",
      "body.weight": "{primitives.fontWeight.regular}"
    },
    "interaction": {
      "minimumTouchTarget": "{primitives.layout.touchTargetMin}",
      "focusOutlineWidth": "{primitives.borderWidth.control}",
      "focusOutlineColor": "{primitives.color.warmWhite}",
      "transitionFast": "{primitives.motion.fast}"
    }
  }
}
